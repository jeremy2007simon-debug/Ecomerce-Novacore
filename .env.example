# ─────────────────────────────────────────────────────────────────────────────
# ATLANTIC SUPPLY — environment
#
# This project runs in DEMO MODE by default. It needs NO environment variables
# to build or run. Every variable below is for a FUTURE production integration
# and is deliberately unset.
#
# NEVER put a real secret in a NEXT_PUBLIC_* variable — those are inlined into
# the client bundle and are readable by anyone.
# ─────────────────────────────────────────────────────────────────────────────

# Commerce data provider. "demo" (default) reads from data/products.ts.
# "shopify" activates lib/commerce/shopify/, which currently throws
# NotConfiguredError — see PRODUCTION INTEGRATION REQUIRED in README.
COMMERCE_PROVIDER=demo

# --- PRODUCTION INTEGRATION REQUIRED: Shopify Storefront API ---
# Server-side only. Required when COMMERCE_PROVIDER=shopify.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-07

# --- PRODUCTION INTEGRATION REQUIRED: payments ---
# The checkout in this demo processes NO money and contacts NO payment provider.
# Wiring a real provider requires a server-side secret key, held here, never
# in the client. Left blank on purpose.
STRIPE_SECRET_KEY=

# --- PRODUCTION INTEGRATION REQUIRED: AI assistant ---
# "ASK ATLANTIC" answers from a local scripted engine (lib/assistant/engine.ts).
# No model is called. A real integration would proxy through a route handler.
ANTHROPIC_API_KEY=

# --- PRODUCTION INTEGRATION REQUIRED: analytics ---
# Events are typed and dispatched to in-memory sinks only. No network calls.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
